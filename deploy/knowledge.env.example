# Optional deploy/.env.knowledge. Host, port and data directory come from Compose.
SUMA_KNOWLEDGE_BACKEND=lancedb
# External embedding requires a real HTTPS endpoint and matching profile:
# SUMA_EMBEDDING_URL=https://provider.example/v1/embeddings
# SUMA_EMBEDDING_MODEL=your-model
# SUMA_EMBEDDING_DIMENSIONS=1536
# SUMA_EMBEDDING_VERSION=your-fixed-profile
# API keys require an explicitly mounted secret or deployment secret manager.
# Bounded queue; default64, valid1..4096.
# SUMA_KNOWLEDGE_MAX_QUEUED_OPERATIONS=64
# An explicit rebuild requires all four values. Reuse the ID to resume without
# resetting consumption/deadline; use a new reviewed ID for a new operation.
# SUMA_KNOWLEDGE_REBUILD_OPERATION_ID=operator-reviewed-rebuild
# SUMA_KNOWLEDGE_REBUILD_MAX_SOURCES=1000
# SUMA_KNOWLEDGE_REBUILD_MAX_EMBEDDING_REQUESTS=1000
# SUMA_KNOWLEDGE_REBUILD_MAX_DURATION_MS=300000
