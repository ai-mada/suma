# Optional deploy/.env.control; keep secrets in individual secret files.
# SUMA_ALLOWED_ORIGINS=https://suma.example.com
# SUMA_SECURE_COOKIES=true
# SQLite automatically persists /var/lib/suma/automation-ingress.key in control_data.
# OceanBase/Postgres overlays mount a shared canonical base64 (32-byte) master key.
# Set its host file path in deploy/.env, never its value here. See containers.md.
