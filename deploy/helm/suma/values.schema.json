{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "driver": {"type": "string", "enum": ["sqlite", "oceanbase", "postgres"]},
        "existingSecret": {"type": "string", "minLength": 1},
        "dsnKey": {"type": "string", "minLength": 1}
      }
    },
    "ingressMasterKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "setupSecret": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "workBuddy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicURL": {"type": "string"},
        "clientID": {"type": "string"},
        "scopes": {"type": "string"},
        "existingSecret": {"type": "string"},
        "clientSecretKey": {"type": "string", "minLength": 1},
        "masterKey": {"type": "string"}
      }
    },
    "secureCookies": {"type": "boolean"}
  }
}
