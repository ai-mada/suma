# Copy to deploy/.env and pass --env-file deploy/.env from the repository root.
# This file contains paths and non-secret settings only. Create secrets separately.
SUMA_PORT=4310
SUMA_SETUP_TOKEN_FILE=./secrets/setup-token
# Optional runner overlay requires all four settings:
# SUMA_RUNNER_PROJECT=actual-project-id
# SUMA_RUNNER_ID=unique-stable-worker-id
# SUMA_RUNNER_WORKSPACE=/absolute/host/path/to/authorized/project
# SUMA_RUNNER_ALLOWLIST=/absolute/host/path/to/commands.json
# SUMA_RUNNER_TOKEN_FILE=./secrets/runner-token
# Optional knowledge overlay:
# SUMA_KNOWLEDGE_TOKEN_FILE=./secrets/knowledge-token
# OceanBase or Postgres overlay requires both secret files:
# SUMA_DB_DSN_FILE=./secrets/database-dsn
# SUMA_INGRESS_MASTER_KEY_FILE=./secrets/ingress-master-key
# Optional WorkBuddy overlay (paths and non-secret values only):
# SUMA_PUBLIC_URL=https://suma.example.com
# SUMA_WORKBUDDY_CLIENT_ID=registered-app-id
# SUMA_WORKBUDDY_SCOPES="user.task.readable user.task.invokable"
# SUMA_WORKBUDDY_CLIENT_SECRET_FILE=./secrets/workbuddy-client-secret
# SUMA_WORKBUDDY_MASTER_KEY_FILE=./secrets/workbuddy-master-key
