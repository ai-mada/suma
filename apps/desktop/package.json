{
  "name": "@suma/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Suma secure desktop workbench",
  "author": "Suma contributors",
  "main": "src/main.cjs",
  "scripts": {"start": "electron .", "typecheck": "node --check src/main.cjs && node --check src/preload.cjs", "test": "node --test tests/*.test.cjs", "prepare:resources": "node scripts/prepare.cjs", "package": "node scripts/package.cjs", "package:dir": "node scripts/package.cjs --format dir"},
  "devDependencies": {"electron": "^35.7.5", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "dev.suma.workbench",
    "productName": "Suma",
    "files": ["src/**/*", "package.json"]
  }
}
