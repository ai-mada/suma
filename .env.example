SUMA_ADDR=127.0.0.1:4310
SUMA_DB_DRIVER=sqlite
SUMA_DB_DSN=.suma/suma.db
SUMA_DATA_DIR=.suma
SUMA_WEB_DIR=apps/web/dist
# Bind externally only after configuring TLS at the reverse proxy.
