{
  "name": "suma",
  "networks": {
    "default": {
      "name": "suma_default",
      "ipam": {}
    }
  },
  "secrets": {
    "database_dsn": {
      "name": "suma_database_dsn",
      "file": "D:\\codes\\ai-dev-os\\suma\\.cache\\e2e\\ingress-stage\\deployment-fixture-database-dsn"
    },
    "ingress_master_key": {
      "name": "suma_ingress_master_key",
      "file": "D:\\codes\\ai-dev-os\\suma\\.cache\\e2e\\ingress-stage\\deployment-fixture-ingress-master-key"
    },
    "setup_token": {
      "name": "suma_setup_token",
      "file": "D:\\codes\\ai-dev-os\\suma\\.cache\\e2e\\ingress-stage\\deployment-fixture-setup-token"
    }
  },
  "services": {
    "control": {
      "build": {
        "context": "D:\\codes\\ai-dev-os\\suma",
        "dockerfile": "Dockerfile",
        "target": "control"
      },
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "SUMA_ADDR": "0.0.0.0:4310",
        "SUMA_DATA_DIR": "/var/lib/suma",
        "SUMA_DB_DRIVER": "postgres",
        "SUMA_DB_DSN_FILE": "/run/secrets/database_dsn",
        "SUMA_INGRESS_MASTER_KEY_FILE": "/run/secrets/ingress_master_key",
        "SUMA_SETUP_TOKEN_FILE": "/run/secrets/setup_token",
        "SUMA_WEB_DIR": "/opt/suma/web"
      },
      "image": "suma-control:local",
      "init": true,
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 4310,
          "published": "4310",
          "protocol": "tcp"
        }
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "setup_token",
          "target": "/run/secrets/setup_token"
        },
        {
          "source": "database_dsn",
          "target": "/run/secrets/database_dsn"
        },
        {
          "source": "ingress_master_key",
          "target": "/run/secrets/ingress_master_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "control_data",
          "target": "/var/lib/suma",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "control_data": {
      "name": "suma_control_data"
    }
  }
}
